{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/features/*": ["./features/*"],
      "@/shared-components/*": ["./shared/components/*"],
      "@/shared-hooks/*": ["./shared/hooks/*"],
      "@/shared-types/*": ["./shared/types/*"],
      "@/shared-libs/*": ["./shared/libs/*"],
      "@/shared-utils/*": ["./shared/utils/*"],
      "@/shared/*": ["./shared/*"],
      "@/providers/*": ["./providers/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
